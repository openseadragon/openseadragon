{
    "name": "openseadragon",
    "version": "6.1.1",
    "description": "Provides a smooth, zoomable user interface for HTML/Javascript.",
    "keywords": [
        "image", "zoom", "pan", "openseadragon", "seadragon", "deepzoom", "dzi", "iiif", "osm", "osd", "tms"
    ],
    "homepage": "https://openseadragon.github.io/",
    "funding": "https://opencollective.com/openseadragon",
    "bugs": {
        "url": "https://github.com/openseadragon/openseadragon/issues"
    },
    "license": "BSD-3-Clause",
    "files": [
        "types/",
        "build/openseadragon/"
    ],
    "main": "build/openseadragon/openseadragon.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/openseadragon/openseadragon.git"
    },
    "engines": {
        "node": "^22.13.0 || >=24"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "eslint": "^10.12.0",
        "eslint-plugin-compat": "^7.0.2",
        "globals": "^17.13.0",
        "nyc": "^18.0.0",
        "puppeteer": "^24.0.0",
        "qunit": "^2.24.1",
        "source-map-explorer": "^2.5.3",
        "tsd": "^0.33.0",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vite-plugin-istanbul": "^9.0.1"
    },
    "scripts": {
        "lint": "eslint src",
        "build": "npm run lint && vite build && vite build --mode min",
        "pretest": "npm run build",
        "test": "node test/run-tests.mjs",
        "posttest": "npm run dts",
        "precoverage": "vite build --mode coverage",
        "coverage": "node test/run-tests.mjs --coverage",
        "postcoverage": "nyc report",
        "prepare": "vite build && vite build --mode min",
        "dev": "node scripts/dev.mjs",
        "dts": "tsc --noEmit -p tsconfig.dts.json && tsd",
        "bundlesize": "node scripts/check-bundle-size.js",
        "bundlesize:visualize": "source-map-explorer build/openseadragon/openseadragon.min.js --no-border-checks",
        "audit-dts": "node scripts/audit-dts.js",
        "package": "npm run build && node scripts/package.mjs",
        "publish-site": "npm run build && node scripts/package.mjs --publish"
    },
    "bundlesize": [
        {
            "path": "build/openseadragon/openseadragon.min.js",
            "maxSize": "95 kB",
            "compression": "gzip"
        },
        {
            "path": "build/openseadragon/openseadragon.min.js",
            "maxSize": "375 kB",
            "compression": "none"
        }
    ],
    "types": "types/index.d.ts",
    "tsd": {
        "directory": "test-dts"
    }
}
